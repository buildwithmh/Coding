# Copy this file to .env. Use unique random secrets (at least 32 characters).
ADMIN_PASSWORD=replace-with-a-long-random-admin-password-at-least-32-chars
JAVA_RUNNER_TOKEN=replace-with-a-different-random-runner-token-at-least-32-chars
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_PASSWORD=replace-with-a-different-long-random-mysql-password
